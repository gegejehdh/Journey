rules_version='2';
service firebase.storage{match /b/{b}/o{match /{p=**}{
 allow read:if true;
 allow write:if request.auth!=null && request.resource.size<15*1024*1024 &&
  firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['superadmin','admin','editor','reporter'];
}}}
